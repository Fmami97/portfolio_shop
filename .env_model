
DB_NAME= # name of the database (ecommerce)
DB_USER= # the user that will connect to your db, avoid using the default postgres
DB_PASSWORD= # place your db user's password here
DB_PORT= #usually postgres uses the port 5432


API_HOST= #localhost
API_PORT=# default is 8000



# You will need a google account
# go to https://console.cloud.google.com/
# after creating an account, search google auth platform in the searchbar
# once in the Oauth platform, select the Clients tab in the left side of the screen
# create a new client, make it a web app, give it the appropriate name
# click "add an URI" button and set it to  http://DB_HOST:API_PORT  (use the actual values not the variable)
# provide a proper authorized redirect URL:
# http://API_HOST:API_PORT/auth/google/callback

GOOGLE_CLIENT_ID = # provided after the steps listed above
GOOGLE_CLIENT_SECRET = # provided after the steps listed above



# You will need a meta developper account, after logging in,
# go to my apps and click the "create App" button on the top right corner.
# After creating the app with the appropriate name, go to app settings/basic

FB_CLIENT_ID = # Paste the App ID value here
FB_CLIENT_SECRET= # Paste the App secret value here

#last step to make the oauth facebook app work is to provide a proper authorized redirect URL
#http://API_HOST:API_PORT/auth/facebook/callback  (use the actual values, not the variables)

